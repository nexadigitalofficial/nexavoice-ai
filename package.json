{
  "name": "sesli-gorev-asistani",
  "version": "1.0.0",
  "description": "Tamamen Offline, Tek Butonlu Gayrimenkul Sesli Not ve Görev Asistanı",
  "main": "www/index.html",
  "scripts": {
    "test": "node tests/test_runner.js",
    "test:py": "python scripts/run_nlp_tests.py",
    "setup:model": "python scripts/download_vosk_model.py",
    "setup:assets": "python scripts/generate_assets.py",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "build:debug": "cd android && gradlew assembleDebug",
    "build:release": "cd android && gradlew assembleRelease"
  },
  "keywords": [
    "vosk",
    "offline-stt",
    "turkish-nlp",
    "capacitor",
    "android",
    "pwa",
    "voice-assistant",
    "real-estate"
  ],
  "author": "Mobil Mimar",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
